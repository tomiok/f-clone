{{define "head"}}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · Firefly</title>
<link rel="stylesheet" href="/static/app.css">
{{if .Refresh}}<meta http-equiv="refresh" content="1;url={{.Refresh}}">{{end}}
{{end}}

{{define "shell-start"}}
<!DOCTYPE html>
<html lang="en"{{if .ScriptDone}} data-script-done="true"{{end}}>
<head>{{template "head" .}}</head>
<body>
<aside class="rail">
  <a class="brand" href="/">Firefly</a>
  <p class="brand-sub">Meeting notes</p>
  <a class="record" href="/new">Record</a>
  <p class="rail-label">Meetings</p>
  <nav aria-label="Meetings">
    {{range .Meetings}}
    <a class="rail-item{{if eq .ID $.CurrentID}} is-current{{end}}" href="{{if .IsActive}}/meetings/{{.ID}}/live{{else}}/meetings/{{.ID}}{{end}}">
      <span>{{.Title}}</span>
      <small>{{if .IsActive}}Live{{else if .IsProcessing}}Transcribing{{else}}{{dur .DurationSec}}{{end}}</small>
    </a>
    {{else}}
    <p class="rail-empty">No meetings yet</p>
    {{end}}
  </nav>
</aside>
<main>
{{end}}

{{define "shell-end"}}
</main>
</body>
</html>
{{end}}

{{define "lines"}}
{{range .Sentences}}
<li>
  <time datetime="PT{{printf "%.0f" .StartSec}}S">{{offset .StartSec}}</time>
  <strong>{{.Speaker}}</strong>
  <p>{{.Text}}</p>
</li>
{{else}}
<li class="muted">No lines yet.</li>
{{end}}
{{end}}

{{define "list"}}
{{template "shell-start" .}}
<p class="eyebrow">Notebook</p>
<h1>Meetings</h1>
<div class="connects">
  <button type="button" class="connect">
    <svg class="brand-icon" viewBox="0 0 48 48" aria-hidden="true">
      <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/>
      <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 12 24 12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"/>
      <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.2 35.1 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
      <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.2-3.5 5.7-6.6 7.1l6.3 5.3C37.4 38.4 44 34 44 24c0-1.3-.1-2.7-.4-3.5z"/>
    </svg>
    Connect Google Calendar
  </button>
  <button type="button" class="connect">
    <svg class="brand-icon" viewBox="0 0 48 48" aria-hidden="true">
      <rect x="2" y="6" width="26" height="36" rx="3" fill="#0F6CBD"/>
      <ellipse cx="15" cy="24" rx="6" ry="8" fill="none" stroke="#fff" stroke-width="2.4"/>
      <path fill="#28A8EA" d="M26 14.5 46 8v32l-20-6.5z"/>
      <path fill="#fff" fill-opacity=".35" d="M26 14.5 46 8v4L26 18.5z"/>
    </svg>
    Connect Outlook Calendar
  </button>
</div>
<div class="cards">
  {{range .Meetings}}
  <a class="card" href="{{if .IsActive}}/meetings/{{.ID}}/live{{else}}/meetings/{{.ID}}{{end}}">
    <h2>{{.Title}}</h2>
    <p class="overview">{{if .IsActive}}Live now{{else if .IsProcessing}}Transcribing{{else}}{{.Overview}}{{end}}</p>
    <p class="meta">{{when .CreatedAt}} · {{dur .DurationSec}}{{if .Actions}} · {{len .Actions}} action items{{end}}</p>
  </a>
  {{else}}
  <p>Record a meeting and the notes will land here.</p>
  {{end}}
</div>
{{template "shell-end" .}}
{{end}}

{{define "new"}}
{{template "shell-start" .}}
<p class="eyebrow">Record</p>
<h1>New meeting</h1>
<p class="muted">Start the notetaker. It will capture the conversation on this page.</p>
{{if .Error}}<p class="error">{{.Error}}</p>{{end}}
<form class="stack" method="post" action="/meetings">
  <label>Title
    <input type="text" name="title" maxlength="120" required value="{{.DraftTitle}}">
  </label>
  <label>Participants
    <input type="text" name="participants" value="{{.Participants}}">
  </label>
  <button type="submit">Start</button>
</form>
{{template "shell-end" .}}
{{end}}

{{define "live"}}
{{template "shell-start" .}}
<p class="eyebrow" id="live-state"><span class="dot"></span> Live</p>
<div class="top">
  <h1>{{.Meeting.Title}}</h1>
  <p class="timer" id="timer" data-start="{{.Meeting.CreatedAt.Format "2006-01-02T15:04:05Z07:00"}}">0:00</p>
</div>
<ul class="people">{{range .Meeting.Participants}}<li>{{.}}</li>{{end}}</ul>
{{if .Error}}<p class="error">{{.Error}}</p>{{end}}
<form id="script-form" method="post" action="/meetings/{{.Meeting.ID}}/lines" hidden>
  <input type="hidden" name="source" value="script">
</form>
<form id="stop-form" method="post" action="/meetings/{{.Meeting.ID}}/stop" hidden></form>
<div class="live-actions">
  <button type="button" class="stop" id="stop">
    <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1.5" fill="currentColor"/></svg>
    Stop
  </button>
  <button type="button" class="resume" id="resume" hidden>
    <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
    Resume
  </button>
</div>
<ol class="transcript" id="transcript">{{template "lines" .Meeting}}</ol>
<script src="/static/live.js" defer></script>
{{template "shell-end" .}}
{{end}}

{{define "transcribing"}}
{{template "shell-start" .}}
<p class="eyebrow">Processing</p>
<h1>Transcribing</h1>
<p class="muted">{{.Meeting.Title}} is being turned into notes.</p>
{{template "shell-end" .}}
{{end}}

{{define "notepad"}}
{{template "shell-start" .}}
<div class="top">
  <div>
    <p class="eyebrow">Notepad</p>
    <h1>{{.Meeting.Title}}</h1>
    <p class="meta">{{when .Meeting.CreatedAt}} · {{dur .Meeting.DurationSec}}</p>
  </div>
  <form method="post" action="/meetings/{{.Meeting.ID}}/delete">
    <button class="ghost" type="submit">Delete</button>
  </form>
</div>
<ul class="people">{{range .Meeting.Participants}}<li>{{.}}</li>{{end}}</ul>
<div class="split">
  <section aria-label="Summary">
    {{if .Meeting.Keywords}}
    <h2>Keywords</h2>
    <ul class="chips">{{range .Meeting.Keywords}}<li>{{.}}</li>{{end}}</ul>
    {{end}}
    <h2>Overview</h2>
    <p>{{.Meeting.Overview}}</p>
    <h2>Notes</h2>
    <ul>
      {{range .Meeting.Notes}}<li>{{.}}</li>{{else}}<li class="muted">No notes.</li>{{end}}
    </ul>
    <h2>Action items</h2>
    {{range .Meeting.Actions}}
    <form method="post" action="/meetings/{{$.Meeting.ID}}/actions/{{.ID}}">
      <button class="action{{if .Done}} is-done{{end}}" type="submit" aria-pressed="{{if .Done}}true{{else}}false{{end}}">
        <span class="box" aria-hidden="true"></span>
        <span>
          <span class="action-text">{{.Text}}</span>
          {{if .Owner}}<span class="owner">{{.Owner}}</span>{{end}}
        </span>
      </button>
    </form>
    {{else}}
    <p class="muted">No action items.</p>
    {{end}}
  </section>
  <section aria-label="Transcript">
    <h2>Transcript</h2>
    <ol class="transcript">{{template "lines" .Meeting}}</ol>
  </section>
</div>
{{template "shell-end" .}}
{{end}}

{{define "missing"}}
{{template "shell-start" .}}
<p class="eyebrow">Notepad</p>
<h1>Meeting not found</h1>
<p class="muted"><a href="/">Back to meetings</a></p>
{{template "shell-end" .}}
{{end}}
